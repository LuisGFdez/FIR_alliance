// Group name for resource allocation must be supplied as environment variable
 
cleanup = false
 
// Group name for resource allocation must be supplied as environment variable
process {
    executor = 'slurm'
    //beforeScript = 'module load StdEnv/2023 ngstools samtools scipy-stack/2025a parasail/2.6.2 rust/1.85.0 clang/18.1.8 bcftools'
    cpus             = 4
    clusterOptions = '--account=rrg-bourqueg-ad'
    memory          = 16.GB
    time            = '3h'
    module = [
        'StdEnv/2023',
        'ngstools',
        'samtools',
        'scipy-stack/2025a',
        'parasail/2.6.2',
        'rust/1.85.0',
        'clang/18.1.8',
        'bcftools'
    ]
    resourceLimits = [
            memory: 1040.GB,
            cpus: 64,
            time: 168.h 
        ]
    withName: bgzip_index_fasta {
        memory = 16.GB
        cpus = 4
        time = '1h'
       
    }
  
    withName: merge_bams {
        memory = { 64.GB * task.attempt }
        cpus = 8
        time = '5h'
        maxRetries = 3
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'finish' }
         
    }
    withName: genotype_strkit {
        memory = 128.GB
        cpus = 8
        time = '3h' 
         
    }
    withName: mendelian_inheritance {
        memory = 8.GB
        cpus = 1
        time = '2h'
          
    }
    withName: targt_denovo {
        memory = 128.GB
        cpus = 8
        time = '4h'
         
    }

}

trace {
    enabled = true
    overwrite = true
    file = 'pipeline_trace.txt'
    fields = 'task_id,name,status,attempt,memory,time,cpus'
}



//nextflow -C hpc_ga4k_config.config run genotype_strkit.nf -resume 2>&1 | tee headnode.log
